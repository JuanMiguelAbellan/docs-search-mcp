{
  "name": "docs-search-mcp",
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts",
    "demo": "tsx examples/agent.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "description": "A read-only MCP server that gives an AI client hybrid (BM25 + embeddings) search over a folder of Markdown/text documents.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rag",
    "bm25",
    "embeddings",
    "search",
    "ai-agent"
  ],
  "author": "Juan Miguel Abellán",
  "repository": {
    "type": "git",
    "url": "https://github.com/JuanMiguelAbellan/docs-search-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "docs-search-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
